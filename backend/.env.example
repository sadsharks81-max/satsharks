NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=mongodb+srv://username:password@cluster.example.mongodb.net/sat-sharks
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ALLOW_MOCK_AUTH=false
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/satsharks92/30min

# Stripe Configuration (For International Payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# PayPro Configuration (For Local Pakistan Payments - Placeholder)
PAYPRO_CLIENT_ID=your_paypro_client_id
PAYPRO_SECRET_KEY=your_paypro_secret_key

# LiveKit Cloud (Live Classroom)
# Get these from your project at https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Live class recordings. The service account needs object access to the GCS
# staging bucket and Contributor access to this folder in a Google Shared Drive.
GOOGLE_SERVICE_ACCOUNT_EMAIL=recordings@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
RECORDING_GCP_BUCKET=your-livekit-recordings-staging-bucket
# Accepts either the folder ID or the full Google Drive folder URL.
RECORDING_DRIVE_FOLDER_ID=https://drive.google.com/drive/folders/your-folder-id
