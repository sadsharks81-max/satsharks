NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=mongodb+srv://username:password@cluster.example.mongodb.net/sat-sharks
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ALLOW_MOCK_AUTH=false
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/satsharks92/30min

# Stripe Configuration (For International Payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# PayPro Configuration (For Local Pakistan Payments - Placeholder)
PAYPRO_CLIENT_ID=your_paypro_client_id
PAYPRO_SECRET_KEY=your_paypro_secret_key

# LiveKit Cloud (Live Classroom)
# Get these from your project at https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Browser-recorded live classes upload directly to the client's Google Drive.
# Create one Google OAuth "Web application" client and add this exact callback.
GOOGLE_DRIVE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5000/api/integrations/google-drive/callback
# Accepts either the folder ID or the complete Google Drive folder URL.
GOOGLE_DRIVE_FOLDER_ID=https://drive.google.com/drive/folders/your-folder-id
